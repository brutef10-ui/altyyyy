{
  "name": "al-studio-server",
  "version": "1.0.0",
  "private": true,
  "description": "Сервер квиз-игры «AL Studio»: Express + Socket.IO. Вся игровая логика, таймер и подсчёт очков выполняются здесь.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "loadtest": "node scripts/loadtest.js",
    "migrate": "node scripts/migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "backup": "node scripts/backup.js",
    "restore-check": "node scripts/restore-check.js",
    "restore": "node scripts/restore.js",
    "google-drive-auth": "node scripts/google-drive-auth.js",
    "loadtest:rooms": "node scripts/loadtest-rooms.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
