# Пример настроек сервера. Скопируйте в .env (он в .gitignore) и заполните.
# Настоящие значения секретов в репозиторий НЕ попадают: на Render они задаются в Environment.

# Порт сервера (Render/Railway подставляют свой PORT автоматически)
PORT=3000

# ---------- База данных (PostgreSQL) ----------
# Локально, например: postgresql://postgres:postgres@localhost:5432/alstudio
# На Render — Internal Database URL базы (подставляется из render.yaml автоматически).
DATABASE_URL=
# disable | require | verify. По умолчанию: disable для localhost и внутренней сети Render, require для внешних адресов.
DATABASE_SSL=
# Необязательно: отдельная схема в той же базе (например, для тестов).
DATABASE_SCHEMA=

# ---------- Вход и сессии ----------
# Секрет для подписи CSRF-токенов, не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# На Render — обязательно (иначе сервер не запустится). Локально без него будет случайный на время работы.
SESSION_SECRET=
# Secure-cookie (только HTTPS). По умолчанию true на Render и при NODE_ENV=production.
COOKIE_SECURE=
# Сессия истекает после N дней без активности и не живёт дольше M дней.
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=60
# Защита от массовых регистраций.
REGISTRATIONS_PER_IP_PER_HOUR=5
REGISTRATIONS_PER_HOUR=300
# Сколько минут действует одноразовый код восстановления, выданный администратором.
RECOVERY_CODE_TTL_MINUTES=60

# ---------- Сроки хранения (дни) ----------
# Журнал заходов: через N дней IP обрезается до сети (/24, /48) и удаляется user-agent; через M дней записи удаляются.
EVENTS_ANONYMIZE_DAYS=180
EVENTS_DELETE_DAYS=1095
# Журнал действий администратора и история блокировок.
AUDIT_RETENTION_DAYS=1095
BAN_HISTORY_RETENTION_DAYS=1095

# ---------- Подсказки о совместном использовании аккаунтов ----------
# Включаются переключателем в админ-консоли (по умолчанию выключены). Здесь — только тонкая настройка.
# Часовой пояс для подсказки «устройства чередуются по времени суток».
SHARING_TIMEZONE=Europe/Moscow
# Веса и пороги (JSON, ключи — как в server/src/admin/sharingConfig.js), например:
# SHARING_CONFIG={"thresholds":{"yellow":30,"red":60},"manyDevices":{"limit":3}}
SHARING_CONFIG=

# ---------- Администратор ----------
# Логин администратора (может быть кириллицей) и ХЭШ его пароля (не сам пароль!).
# Хэш: cd server && npm run hash-password
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
# Контакт, который видят заблокированные пользователи.
ADMIN_CONTACT=

# ---------- Адреса сайтов ----------
# Адреса (origin) сайтов, которым разрешено обращаться к серверу (CORS).
# Можно указать несколько через запятую, без завершающего слэша.
HOST_SITE_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
PLAYER_SITE_ORIGIN=http://localhost:5501,http://127.0.0.1:5501

# Публичный адрес сайта игрока — его увидят игроки на экране лобби (и в QR-коде).
# Если не задан, берётся первый адрес из PLAYER_SITE_ORIGIN.
PLAYER_SITE_URL=
# Куда ведёт кнопка «Создать свою игру» на сайте игрока. Если не задан — /host/ (SERVE_SITES)
# или первый адрес из HOST_SITE_ORIGIN.
HOST_SITE_URL=

# true — сервер сам отдаёт оба сайта: игрок — «/», ведущий — «/host/» (один сервис, без CORS).
SERVE_SITES=false

# ---------- IP клиента за прокси ----------
# Сколько прокси стоит перед сервером (на Render — см. docs/ACCOUNTS_PLAN.md, раздел 4).
# Берётся N-й адрес СПРАВА в X-Forwarded-For: первый адрес заголовка клиент может подделать.
TRUST_PROXY=false
TRUST_PROXY_HOPS=
# hops (по умолчанию) или header — взять IP из заголовка, который доверенный прокси всегда перезаписывает.
CLIENT_IP_MODE=hops
CLIENT_IP_HEADER=

# ---------- Старые данные ----------
# Файл с играми из версии без аккаунтов. При старте игры из него переносятся в БД (повторно не дублируются)
# и забираются в аккаунт кнопкой «Перенести в мой аккаунт» в том же браузере.
DATA_FILE=./data/quizzes.json

# ---------- Игра ----------
# Сколько ждать переподключения ведущего (мс), прежде чем закрыть комнату.
HOST_RECONNECT_MS=15000
# Сколько ждать переподключения игрока в лобби (мс), прежде чем убрать его из списка.
PLAYER_RECONNECT_MS=600000

# Ограничения
MAX_PLAYERS_PER_ROOM=200
MAX_ROOMS=500
